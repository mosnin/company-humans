{
  "name": "@company-human/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./clerk-users": {
      "types": "./dist/clerk-users.d.ts",
      "default": "./dist/clerk-users.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --config ../../eslint.config.mjs",
    "test": "vitest run --passWithNoTests",
    "migrate": "npm run build -w @company-human/contracts && npm run build && node dist/migrate-cli.js",
    "seed": "npm run build -w @company-human/contracts && npm run build && node dist/seed-cli.js"
  },
  "dependencies": {
    "@company-human/contracts": "0.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  }
}
