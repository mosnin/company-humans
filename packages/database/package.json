{
  "name": "@company-human/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth-users": {
      "types": "./dist/auth-users.d.ts",
      "default": "./dist/auth-users.js"
    },
    "./rls": {
      "types": "./dist/rls.d.ts",
      "default": "./dist/rls.js"
    },
    "./organizations": {
      "types": "./dist/organizations.d.ts",
      "default": "./dist/organizations.js"
    },
    "./membership-lifecycle": {
      "types": "./dist/membership-lifecycle.d.ts",
      "default": "./dist/membership-lifecycle.js"
    },
    "./organization-authority": {
      "types": "./dist/organization-authority.d.ts",
      "default": "./dist/organization-authority.js"
    },
    "./product-instances": {
      "types": "./dist/product-instances.d.ts",
      "default": "./dist/product-instances.js"
    },
    "./role-permissions": {
      "types": "./dist/role-permissions.d.ts",
      "default": "./dist/role-permissions.js"
    },
    "./administration": {
      "types": "./dist/administration.d.ts",
      "default": "./dist/administration.js"
    },
    "./teams": {
      "types": "./dist/teams.d.ts",
      "default": "./dist/teams.js"
    },
    "./provisioning-operations": {
      "types": "./dist/provisioning-operations.d.ts",
      "default": "./dist/provisioning-operations.js"
    },
    "./provisioning-dispatcher": {
      "types": "./dist/provisioning-dispatcher.d.ts",
      "default": "./dist/provisioning-dispatcher.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src --config ../../eslint.config.mjs",
    "test": "vitest run --passWithNoTests",
    "migrate": "npm run build -w @company-human/contracts && npm run build && node dist/migrate-cli.js",
    "seed": "npm run build -w @company-human/contracts && npm run build && node dist/seed-cli.js"
  },
  "dependencies": {
    "@company-human/contracts": "0.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  }
}
