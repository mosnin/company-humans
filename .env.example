# Company Human web application
# No credentials are required to build the foundation scaffold.
# VERCEL_GIT_COMMIT_SHA is supplied automatically by Vercel when deployed.

# Required for migration and seed commands. Use a dedicated Company Human database.
# Never commit a real credential.
DATABASE_URL=postgresql://user:password@localhost:5432/company_human

# Required for tenant reads. Must authenticate as a separate LOGIN role granted
# company_human_app; never point this at the migration/table owner connection.
DATABASE_RUNTIME_URL=postgresql://app_user:password@localhost:5432/company_human

# Server writes use a separate LOGIN role granted company_human_service.
# Do not grant it migration ownership, superuser, BYPASSRLS, or identity-role membership.
DATABASE_SERVICE_URL=postgresql://service_user:password@localhost:5432/company_human

# OAuth identity synchronization uses a separate LOGIN role granted company_human_identity.
# This credential is server-only and cannot write organization-scoped tables.
DATABASE_IDENTITY_URL=postgresql://identity_user:password@localhost:5432/company_human

# Convex Auth manages OAuth sessions. Never use another product's deployment.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# Only list providers configured on the matching Convex deployment.
AUTH_ENABLED_PROVIDERS=github,google
# On Convex (not in client environment): SITE_URL, JWT_PRIVATE_KEY, JWKS,
# AUTH_GITHUB_ID, AUTH_GITHUB_SECRET, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET.
